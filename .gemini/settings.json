{
  "mcpServers": {
    "code-review-graph": {
      "command": "/home/sk/.local/bin/code-review-graph",
      "args": [
        "mcp",
        "--auto-watch",
        "--repo",
        "/mnt/5893accc-4b16-4de7-b2a7-6333530b2614/PROJECTS/21_Active/dither-guy"
      ],
      "cwd": "/mnt/5893accc-4b16-4de7-b2a7-6333530b2614/PROJECTS/21_Active/dither-guy"
    },
    "codebase-memory-mcp": {
      "command": "/home/sk/.local/bin/codebase-memory-mcp"
    },
    "headroom": {
      "command": "/home/sk/.local/bin/headroom",
      "args": [
        "mcp",
        "serve"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/crg-session-start.sh",
            "name": "code-review-graph status",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "write_file|replace|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash .gemini/hooks/crg-update.sh",
            "name": "code-review-graph update",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
